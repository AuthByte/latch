{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix web ci",
  "buildCommand": "npm run build && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "dist/**" }
  },
  "rewrites": [
    { "source": "/v0/:path*", "destination": "/api" },
    { "source": "/j/:path*", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
